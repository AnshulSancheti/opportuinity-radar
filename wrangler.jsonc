{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opportunity-radar",
  "account_id": "400d816fdb1a5f1ac541f7001ab7047a",
  "main": "cloudflare/index.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "frontend/out",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opportunity-radar",
      "database_id": "f83f8b1d-0a10-4d54-aa03-40978b6279c6",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "routes": [
    {
      "pattern": "hackathons.intelligentape.online",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "APP_ORIGIN": "https://hackathons.intelligentape.online",
    "HACKATHON_REFRESH_HOURS": "6"
  },
  "triggers": {
    "crons": [
      "0 */6 * * *",
      "30 * * * *"
    ]
  },
  "queues": {
    "producers": [
      {
        "binding": "INGESTION_QUEUE",
        "queue": "opportunity-radar-ingestion"
      }
    ],
    "consumers": [
      {
        "queue": "opportunity-radar-ingestion",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 2,
        "max_concurrency": 1
      }
    ]
  }
}
