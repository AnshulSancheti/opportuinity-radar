# Environment
# Host tools (local pytest, etc.): use localhost. Docker Compose overrides this for backend/worker.
DATABASE_URL=postgresql+psycopg://opportunity:password@localhost:5432/opportunity_radar

# API
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
CORS_ORIGINS=http://localhost:3000

# Scraper defaults
SCRAPER_USER_AGENT=OpportunityRadar/1.0
SCRAPER_DEFAULT_DELAY_MS=1000
SCRAPER_DEFAULT_TIMEOUT_SECONDS=20
SCRAPER_DEFAULT_MAX_RETRIES=3

# Admin (M8.3)
ADMIN_PASSWORD=change-me

# Job matching agent (M9)
# Leave ANTHROPIC_API_KEY empty to disable matching — the rest of the app is
# unaffected and /matches/status reports enabled=false so the UI hides it.
ANTHROPIC_API_KEY=
# claude-haiku-4-5 is $1/$5 per million tokens, which scores the full job table
# for well under a dollar. Switch to claude-opus-5 for deeper per-job reasoning
# at 5x the input cost.
MATCH_MODEL=claude-haiku-4-5
MATCH_BATCH_LIMIT=25

# Telegram alerts (M6.5)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email alerts (deferred)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
